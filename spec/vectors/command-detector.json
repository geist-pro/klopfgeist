      "context": {"policy": "listening"},
      "steps": [
        {"at": 7.55, "words": [["continue", 5.0, 7.5]]},
        {"at": 7.9, "tick": true, "expect": [{"reject": "tooLong", "text": "continue"}]}
      ]
    },
    {
